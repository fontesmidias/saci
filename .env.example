# ===============================================================
# MODELO de configuração. Copie este arquivo para ".env" e
# preencha apenas as chaves que você já tem.
#
#   copy .env.example .env      (PowerShell / CMD)
#
# O arquivo ".env" está no .gitignore e NUNCA vai para o git.
# Não coloque valores reais AQUI neste arquivo de exemplo.
# ===============================================================

# --- Etapa 2: as duas primeiras (sem cartão de crédito) --------

# Google AI Studio — https://aistudio.google.com/
# Cota grátis mais generosa. Formato da chave: AIzaSy...
GEMINI_API_KEY=

# Groq Cloud — https://console.groq.com/keys
# O mais rápido. Formato da chave: gsk_...
GROQ_API_KEY=


# --- Etapa 6: provedores extras (deixe vazio por enquanto) -----

# NVIDIA NIM — https://build.nvidia.com/  (chave nvapi-...)
NVIDIA_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (chave sk-or-v1-...)
OPENROUTER_API_KEY=

# Mistral AI — https://console.mistral.ai/
MISTRAL_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
# (a conta testada deu HTTP 402: exige plano pago)
CEREBRAS_API_KEY=

# SambaNova — https://cloud.sambanova.ai/  (30 RPM gratis, sem cartao)
SAMBANOVA_API_KEY=

# Hyperbolic — https://app.hyperbolic.xyz/  (60 RPM gratis)
HYPERBOLIC_API_KEY=

# SiliconFlow — https://siliconflow.cn/  (modelos 7B/9B gratis + 20M bonus)
SILICONFLOW_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens
HF_API_KEY=

# LLM7.io NAO precisa de chave: ja funciona como ultima rede da cascata.


# --- Preferências ----------------------------------------------

# Ordem da cascata de fallback (separada por vírgula).
# Provedores sem chave preenchida são pulados automaticamente.
LLM_ROUTER_ORDER=groq,google,mistral,nvidia,openrouter,llm7

# Timeout por tentativa, em segundos.
LLM_ROUTER_TIMEOUT=60

# Perfil padrao: code, plan, fast, long, pt
LLM_ROUTER_PROFILE=fast
