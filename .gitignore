# ---------------------------------------------------------------
# SEGREDOS — nunca commitar. Esta seção vem primeiro de propósito.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Cache de descoberta de modelos (pode conter metadados da conta)
providers.local.json

# Logs do PM2
logs/
*.log

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ---------------------------------------------------------------
# Editor / SO
# ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
desktop.ini
# Banco de consumo (local, com historico de uso)
usage.db
usage.db-*
usage.pre-m*.db

# Preferencias de runtime (perfil ativo, trava manual)
prefs.json

# Artefatos do PyInstaller (gerados por: py -m PyInstaller saci.spec)
# saci.spec E saci/saci.ico SAO versionados -- sao o "codigo-fonte" da
# build; build/ e dist/ sao a saida, regenerada a cada build.
build/
dist/
